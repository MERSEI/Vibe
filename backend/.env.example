# PostgreSQL (обязательно)
# Сначала примени schema.sql: psql $DATABASE_URL -f backend/schema.sql
DATABASE_URL=postgresql://postgres:secret@localhost:5432/vibe_rag

# Google Gemini API key (обязательно для эмбеддингов)
# Бесплатный ключ: https://aistudio.google.com/app/apikey
# Тот же ключ что VITE_GEMINI_API_KEY во фронтенде
GEMINI_API_KEY=AIzaSy...

# Порт Express (по умолчанию 3001)
PORT=3001

# CORS origin фронтенда (по умолчанию http://localhost:3000)
CORS_ORIGIN=http://localhost:3000

# Grafana OTLP (опционально — для телеметрии)
VITE_GRAFANA_ENDPOINT=https://your-instance.grafana.net/otlp
grafana_url=https://your-instance.grafana.net/
grafana_token=your_grafana_service_account_token_here

